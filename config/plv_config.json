  },
  "navigation_rois": [
    "Hippocampus L_Anterior",
    "Hippocampus L_Posterior",
    "Hippocampus R_Anterior",
    "ParaHippocampal L",
    "OFCpost L"
  ],
  "overwrite": {
    "selection": false,
    "observed": false,
    "shuffle": false,
    "statistics": false,
    "behavior_metrics": false
  }
