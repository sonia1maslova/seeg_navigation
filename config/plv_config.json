      17,
      18,
      19,
      20,
      21,
      22,
      23,
      24
    ]
  },
  "qc": {
    "kurtosis_threshold": 5.0
  },
  "shuffle": {
    "method": "independent_trial_shift",
    "n_shuffles": 5000,
    "min_shift_sec": 0.5,
    "base_seed": 20260817
  },
  "parallel": {
    "workers": 30
  },
  "behavior_metrics": {
    "target_pair_keys": [
      "aMTG_LAntHipp",
      "aMTG_LPostHipp",
      "aMTG_RAntHipp"
    ],
    "metrics": [
      "raw_plv",
      "z_plv"
    ],
    "default_metric": "z_plv",
    "null_reproduction_tolerance": 1e-12,
    "behavior_column": "pointing_error",
    "lmm": {
      "min_subjects": 2,
      "condition_adjustment": "adaptive_if_multiple_levels",
      "multiple_comparison_correction": "none",
      "min_trials": 3,
      "reml": true,
      "singular_tolerance": 0.0001,
      "optimizer": "bobyqa",
      "maxfun": 200000
    },
    "subject_correlation": {
      "min_subjects": 3,
      "methods": [
        "pearson",
        "spearman"
      ],
      "trial_matching": "exact_finite_metric_and_behavior_rows",
      "multiple_comparison_correction": "none"
    }
  },
  "cortical_rois": {
    "corridor": [
      "Temporal_Mid L_Anterior",
      "Temporal_Mid L_Posterior",
      "SupraMarginal L",
      "Temporal_Sup L",
      "Precentral L"
    ],
    "junction": [
      "Temporal_Mid L_Anterior",
      "Temporal_Mid L_Posterior",
      "SupraMarginal L",
      "Temporal_Sup L",
      "Frontal_Inf_Orb_2 L"
